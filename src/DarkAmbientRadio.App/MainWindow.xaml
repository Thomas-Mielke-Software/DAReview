<Window x:Class="DarkAmbientRadio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DarkAmbientRadio.App.ViewModels"
        Title="Dark Ambient Radio – Review" Height="640" Width="1040"
        Background="#111111" Foreground="#FFFFFF"
        FontFamily="Verdana, Arial, Helvetica" FontSize="12"
        Icon="appicon.ico"
        Loaded="OnLoaded" Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Brand palette: bg #111111 / #000000, text #FFFFFF, accent cyan #99EEFF, lime #93C900 -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#99EEFF"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#99EEFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base for approve/reject: own template so brand colours show, scale-up on press. -->
        <Style x:Key="DecisionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.14" ScaleY="1.14"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApproveButtonStyle" TargetType="Button" BasedOn="{StaticResource DecisionButton}">
            <Setter Property="Background" Value="#1A2400"/>
            <Setter Property="BorderBrush" Value="#3A4F00"/>
            <Setter Property="Foreground" Value="#7E9A3A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsApproved}" Value="True">
                    <Setter Property="Background" Value="#93C900"/>
                    <Setter Property="BorderBrush" Value="#C4F52E"/>
                    <Setter Property="Foreground" Value="#0A0A0A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RejectButtonStyle" TargetType="Button" BasedOn="{StaticResource DecisionButton}">
            <Setter Property="Background" Value="#241414"/>
            <Setter Property="BorderBrush" Value="#4A2A28"/>
            <Setter Property="Foreground" Value="#B08A88"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRejected}" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                    <Setter Property="BorderBrush" Value="#E87070"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Counterpart to "Airplay ▶": discards the album. Same red family as the track
             reject buttons, but only fully saturated on hover — it deletes folders. -->
        <Style x:Key="RejectAlbumButtonStyle" TargetType="Button" BasedOn="{StaticResource DecisionButton}">
            <Setter Property="Background" Value="#7E2A22"/>
            <Setter Property="BorderBrush" Value="#C0392B"/>
            <Setter Property="Foreground" Value="#FFD9D5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                    <Setter Property="BorderBrush" Value="#E87070"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Album list item: cyan selection highlight. -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#1E1E1E" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#181818"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0E2A33"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#99EEFF"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="0,0,3,1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#000000" Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Code einlösen" Command="{Binding AcquireCommand}"/>
                <Button Content="↻ Review neu einlesen" Command="{Binding RefreshCommand}"/>
                <Button Content="Einstellungen" Command="{Binding OpenSettingsCommand}"/>
                <Button Content="▶ Weiter (Login erledigt)"
                        Command="{Binding ContinueLoginCommand}"
                        Foreground="#0A0A0A" Background="#93C900" BorderBrush="#C4F52E"
                        Visibility="{Binding ShowContinueButton, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#000000" Padding="12,6">
            <TextBlock Text="{Binding StatusText}" Foreground="#99EEFF"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Album list (drop target for .zip files and album folders) -->
            <DockPanel Grid.Column="0" Margin="12">
                <TextBlock DockPanel.Dock="Top" Foreground="#667777" FontSize="11" Margin="2,0,2,6"
                           Text="Alben im Review — .zip oder Album-Ordner hierher ziehen"/>
                <ListBox Background="#0A0A0A" BorderBrush="#222222" Foreground="#FFFFFF"
                         AllowDrop="True" DragOver="OnAlbumListDragOver" Drop="OnAlbumListDrop"
                         ItemsSource="{Binding Albums}"
                         SelectedItem="{Binding SelectedAlbum}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AlbumViewModel}">
                            <Grid Margin="4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextWrapping="Wrap" Foreground="#FFFFFF"/>
                                <Border Grid.Column="1" Background="#1A2400" BorderBrush="#3A4F00" BorderThickness="1"
                                        CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding ListenPercentText}" Foreground="#93C900" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Player / track review -->
            <DockPanel Grid.Column="1" Margin="0,12,12,12">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding SelectedAlbum.Name}"
                               FontSize="18" FontWeight="Bold" Foreground="#99EEFF"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <!-- Capitalisation fixes: folder name, track filenames and ID3 tags. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="10,0,10,0">
                        <Button Content="Aa Artist" Command="{Binding NormalizeArtistCommand}"
                                Padding="10,8" Margin="0,0,6,0"
                                ToolTip="Schreibweise des Artists normalisieren (Ordner, Dateinamen, ID3-Tags)"/>
                        <Button Content="Aa Album" Command="{Binding NormalizeAlbumTitleCommand}"
                                Padding="10,8" Margin="0,0,14,0"
                                ToolTip="Schreibweise des Album-Titels normalisieren (Ordner, Dateinamen, ID3-Tags)"/>
                        <Button Content="✓ Alle" Command="{Binding SelectedAlbum.ApproveAllCommand}"
                                Foreground="#93C900" BorderBrush="#3A4F00"
                                Padding="10,8" Margin="0" FontWeight="Bold"
                                ToolTip="Alle noch nicht bewerteten Tracks freigeben (Abgelehnte bleiben abgelehnt)"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Airplay ▶" Command="{Binding PublishCommand}"
                            Foreground="#0A0A0A" Background="#93C900" BorderBrush="#C4F52E"
                            Padding="14,8" Margin="0" FontWeight="Bold"/>
                    <Button Grid.Column="3" Content="✕ Ablehnen" Command="{Binding RejectAlbumCommand}"
                            Style="{StaticResource RejectAlbumButtonStyle}"
                            Padding="14,8" Margin="10,0,0,0"
                            ToolTip="Album verwerfen – Ordner in den Papierkorb verschieben"/>
                </Grid>

                <!-- Audio player (no visual surface needed for MP3) -->
                <MediaElement x:Name="Player" DockPanel.Dock="Bottom" Height="0"
                              LoadedBehavior="Manual" UnloadedBehavior="Stop" ScrubbingEnabled="True"
                              MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed"/>

                <!-- Transport bar -->
                <Border DockPanel.Dock="Bottom" Background="#0A0A0A" BorderBrush="#222222" BorderThickness="1"
                        CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayPauseButton" Grid.Column="0" Content="⏵" Width="46" Margin="0"
                                FontSize="15" Click="OnPlayPause"/>
                        <TextBlock x:Name="CurrentTime" Grid.Column="1" Text="0:00" Margin="12,0,8,0"
                                   VerticalAlignment="Center" Foreground="#99EEFF" MinWidth="38"/>
                        <Slider x:Name="PositionSlider" Grid.Column="2" Minimum="0" Maximum="1" Value="0"
                                IsMoveToPointEnabled="True" VerticalAlignment="Center" Foreground="#99EEFF"
                                ValueChanged="OnPositionSliderChanged"/>
                        <TextBlock x:Name="TotalTime" Grid.Column="3" Text="0:00" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="#889999" MinWidth="38"/>
                    </Grid>
                </Border>

                <!-- ID3 info of the playing track. Docked after the transport bar, so it lands
                     between the track list and the player. -->
                <Border DockPanel.Dock="Bottom" Background="#0A0A0A" BorderBrush="#222222" BorderThickness="1"
                        CornerRadius="4" Padding="10,7" Margin="0,8,0,0"
                        Visibility="{Binding HasTrackInfo, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding TrackInfo.Title}" Foreground="#99EEFF" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <ItemsControl ItemsSource="{Binding TrackInfo.Chips}" Margin="0,5,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TrackInfoChip}">
                                    <StackPanel Orientation="Horizontal" Margin="0,2,18,0">
                                        <TextBlock Text="{Binding Label}" Foreground="#667777" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="260">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Style.Triggers>
                                                        <!-- e.g. a 320k folder import that never got re-encoded -->
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="#E8A317"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedAlbum.Tracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TrackViewModel}">
                                <Border Margin="0,3" CornerRadius="4" Padding="8,6" Background="#141414"
                                        MouseLeftButtonDown="OnTrackClicked" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="#222222"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsApproved}" Value="True">
                                                    <Setter Property="Background" Value="#18220A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                                    <Setter Property="Background" Value="#231212"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#99EEFF"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Number}" FontWeight="Bold"
                                                   Foreground="#889999" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="✓ Approve" Command="{Binding ApproveCommand}"
                                                    Style="{StaticResource ApproveButtonStyle}"/>
                                            <Button Content="✕ Reject" Command="{Binding RejectCommand}"
                                                    Style="{StaticResource RejectButtonStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
